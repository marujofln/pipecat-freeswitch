<include>
  <context name="default">
    <!-- 9999: stream the caller's audio to the bench WebSocket server (mono, 16 kHz).
         The last argument is the channel UUID, sent as the first text message. -->
    <extension name="pipecat_bench">
      <condition field="destination_number" expression="^9999$">
        <action application="answer"/>
        <action application="set" data="STREAM_BUFFER_SIZE=20"/>
        <action application="set" data="stream_result=${uuid_audio_stream(${uuid} start ws://127.0.0.1:8765/ws mono 16k ${uuid})}"/>
        <action application="log" data="INFO uuid_audio_stream -> ${stream_result}"/>
        <action application="park"/>
      </condition>
    </extension>
    <!-- 9998: stream to a Pipecat bot using FreeSWITCHFrameSerializer (bench/tone_bot.py), 8 kHz.
         The bot only accepts the WebSocket with the bearer token, sent as an extra handshake header. -->
    <extension name="pipecat_bot">
      <condition field="destination_number" expression="^9998$">
        <action application="answer"/>
        <action application="set" data='STREAM_EXTRA_HEADERS={"Authorization":"Bearer $${bot_token}"}'/>
        <action application="set" data="stream_result=${uuid_audio_stream(${uuid} start ws://127.0.0.1:8766/ws mono 8k ${uuid})}"/>
        <action application="park"/>
      </condition>
    </extension>
    <!-- 9996: the example voice bot (examples/bot.py, service "bot" in docker-compose.yml), 8 kHz. -->
    <extension name="pipecat_voice_bot">
      <condition field="destination_number" expression="^9996$">
        <action application="answer"/>
        <action application="set" data='STREAM_EXTRA_HEADERS={"Authorization":"Bearer $${bot_token}"}'/>
        <action application="set" data="stream_result=${uuid_audio_stream(${uuid} start ws://127.0.0.1:8767/ws mono 8k ${uuid})}"/>
        <action application="park"/>
      </condition>
    </extension>
    <!-- 9997: same tone bot as 9998, caller audio streamed at 16 kHz (wideband codecs such as Opus). -->
    <extension name="pipecat_bot_16k">
      <condition field="destination_number" expression="^9997$">
        <action application="answer"/>
        <action application="set" data='STREAM_EXTRA_HEADERS={"Authorization":"Bearer $${bot_token}"}'/>
        <action application="set" data="stream_result=${uuid_audio_stream(${uuid} start ws://127.0.0.1:8766/ws mono 16k ${uuid})}"/>
        <action application="park"/>
      </condition>
    </extension>
  </context>
</include>
