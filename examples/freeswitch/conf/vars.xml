<include>
  <X-PRE-PROCESS cmd="set" data="domain=$${local_ip_v4}"/>
  <X-PRE-PROCESS cmd="set" data="default_password=1234"/>
  <!-- Softphones on the internal profile can use Opus or G.711 (the bench profile has its own list). -->
  <X-PRE-PROCESS cmd="set" data="global_codec_prefs=OPUS,PCMU,PCMA"/>
  <X-PRE-PROCESS cmd="set" data="outbound_codec_prefs=OPUS,PCMU,PCMA"/>
  <X-PRE-PROCESS cmd="set" data="internal_sip_port=5060"/>
  <X-PRE-PROCESS cmd="set" data="default_areacode=11"/>
  <!-- Bearer token sent to the Pipecat bot (bench/tone_bot.py BOT_TOKEN). Use a long random value outside the bench. -->
  <X-PRE-PROCESS cmd="set" data="bot_token=bench-token"/>
  <!-- WebSocket ping interval to the bot, in seconds (STREAM_HEART_BEAT). mod_audio_stream drops the
       connection after two unanswered pings, so a bot host that vanishes without closing TCP is found
       within 2-3 intervals, and conf/scripts/audio_stream_hangup.lua hangs the call up. -->
  <X-PRE-PROCESS cmd="set" data="stream_heart_beat=5"/>
</include>
