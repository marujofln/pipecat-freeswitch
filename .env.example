# Copy to .env (git-ignored) and fill in. Read by examples/bot.py (python-dotenv) and by the "bot" service of
# examples/freeswitch/docker-compose.yml. Only the keys of the providers you pick are required.

# Bearer token FreeSWITCH sends on the WebSocket handshake: the same value as bot_token in vars.xml.
# The bench's compose service always uses "bench-token", matching the bench's vars.xml.
BOT_TOKEN=

# Speech-to-text: deepgram (default) or openrouter (experimental: not streamed, adds latency per turn).
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
# STT_MODEL=openai/whisper-1              # with STT_PROVIDER=openrouter

# LLM: openai (default) or openrouter.
LLM_PROVIDER=openai
OPENAI_API_KEY=
# LLM_MODEL=gpt-4.1-mini                  # openrouter default: openai/gpt-4.1-mini

# Text-to-speech: cartesia (default), elevenlabs or openrouter (experimental: OpenAI voices only).
TTS_PROVIDER=cartesia
CARTESIA_API_KEY=
# CARTESIA_VOICE_ID=
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# TTS_MODEL=openai/gpt-4o-mini-tts        # with TTS_PROVIDER=openrouter
# TTS_VOICE=alloy                         # an OpenAI voice name

# One key for every OpenRouter option above.
# OPENROUTER_API_KEY=

# Event socket, if FreeSWITCH is not on this host or does not use the defaults.
# FREESWITCH_ESL_HOST=127.0.0.1
# FREESWITCH_ESL_PORT=8021
# FREESWITCH_ESL_PASSWORD=ClueCon
