# Copy to .env (git-ignored) and fill in. Read by examples/bot.py (python-dotenv) and by the "bot" service of
# examples/freeswitch/docker-compose.yml.

# Bearer token FreeSWITCH sends on the WebSocket handshake: the same value as bot_token in vars.xml.
# The bench's compose service always uses "bench-token", matching the bench's vars.xml.
BOT_TOKEN=

DEEPGRAM_API_KEY=
OPENAI_API_KEY=

# Text-to-speech: cartesia (default) or elevenlabs.
TTS_PROVIDER=cartesia
CARTESIA_API_KEY=
# CARTESIA_VOICE_ID=
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# Event socket, if FreeSWITCH is not on this host or does not use the defaults.
# FREESWITCH_ESL_HOST=127.0.0.1
# FREESWITCH_ESL_PORT=8021
# FREESWITCH_ESL_PASSWORD=ClueCon
